	fragment@190 {
		phandle = <0x318>;
		target = <0xffffffff>;

		__overlay__ {

			goodix_fp {
				panel = <0x107>;
				interrupt-names = "goodix_wake_up";
				vdd-supply = <0xffffffff>;
				fp-gpio-irq = <0xffffffff 0x63 0x2008>;
				fp-gpio-reset = <0xffffffff 0xd7 0x00>;
				pinctrl-1 = <0x30c>;
				pinctrl-0 = <0x30b>;
				pinctrl-names = "goodix_active", "goodix_suspend";
				interrupts = <0x63 0x2008>;
				interrupt-parent = <0xffffffff>;
				reg = <0x00>;
				qcom,qup-id = <0x03>;
				spi-max-frequency = "", "I>";
				compatible = "goodix,fingerprint";
				status = "ok";
			};

			gpio_keys {
				pinctrl-0 = <0x30d 0x30e 0xffffffff>;
				pinctrl-names = "default";
				label = "gpio-keys";
				compatible = "gpio-keys";

				focus {
					linux,can-disable;
					debounce-interval = <0x0f>;
					gpio-key,wakeup;
					linux,code = <0x210>;
					linux,input-type = <0x01>;
					gpios = <0xffffffff 0xb3 0x01>;
					label = "focus_key";
				};

				shoot {
					linux,can-disable;
					debounce-interval = <0x0f>;
					gpio-key,wakeup;
					linux,code = <0xd4>;
					linux,input-type = <0x01>;
					gpios = <0xffffffff 0x5f 0x01>;
					label = "shoot_key";
				};
			};

			gpio_keys_nubia {
				pinctrl-0 = <0x30f>;
				pinctrl-names = "default";
				label = "gpio-keys_nubia";
				compatible = "gpio-keys_nubia";
				status = "ok";

				game_sw {
					gpio-key,wakeup;
					debounce-interval = <0x1e>;
					linux,code = <0x0a>;
					linux,input-type = <0x05>;
					gpion = <0xffffffff 0xae 0x00>;
					gpios = <0xffffffff 0x61 0x00>;
					label = "game_sw";
				};
			};

