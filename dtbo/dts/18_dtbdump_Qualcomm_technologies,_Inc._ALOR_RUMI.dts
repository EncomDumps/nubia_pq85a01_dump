			vdda-qref-max-microamp = <0x352>;
			vdda-refgen-supply = <0xffffffff>;
			vdda-refgen-max-microamp = <0xcee>;
			status = "ok";
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			limit-tx-hs-gear = <0x01>;
			limit-rx-hs-gear = <0x01>;
			limit-rate = <0x02>;
			rpm-level = <0x00>;
			spm-level = <0x00>;
			vcc-supply = <0xffffffff>;
			vcc-max-microamp = <0x124f80>;
			vccq-supply = <0xffffffff>;
			vccq-max-microamp = <0x124f80>;
			qcom,vddp-ref-clk-supply = <0xffffffff>;
			qcom,vddp-ref-clk-max-microamp = <0x64>;
			qcom,vccq-parent-supply = <0xffffffff>;
			qcom,vccq-parent-max-microamp = <0x7cc180>;
			reset-gpios = <0xffffffff 0xcd 0x01>;
			resets = <0xffffffff 0x16>;
			reset-names = "rst";
			clock-names = "core_clk", "bus_aggr_clk", "iface_clk", "core_clk_unipro", "core_clk_ice", "ref_clk", "tx_lane0_sync_clk", "rx_lane0_sync_clk", "rx_lane1_sync_clk";
			clocks = <0xffffffff 0x95 0xffffffff 0x01 0xffffffff 0x94 0xffffffff 0xa4 0xffffffff 0x98 0xffffffff 0x00 0xffffffff 0xa2 0xffffffff 0x9e 0xffffffff 0xa0>;
			qcom,disable-lpm;
			qcom,iommu-dma = "bypass";
			status = "ok";
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			dwc3@a600000 {
				usb-phy = <0x01 0xffffffff>;
				dr_mode = "peripheral";
				maximum-speed = "high-speed";
			};
		};
	};

	fragment@6 {
