/dts-v1/;

/ {
	model = "Qualcomm technologies, Inc. ALOR RUMI";
	compatible = "qcom,alor-rumi", "qcom,alor", "qcom,rumi";
	qcom,msm-id = <0x2ad 0x10000>;
	qcom,board-id = <0x0f 0x00>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			clock-frequency = <0x4c4b40>;
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			phy@a784000 {
				compatible = "qcom,usb-emu-phy";
				reg = <0x00 0xa784000 0x00 0x9500>;
				qcom,emu-init-seq = <0xfffff 0x04 0xffff0 0x04 0x100000 0x20 0x00 0x20 0x101f0 0x20 0x100000 0x3c 0x00 0x3c 0x00 0x04>;
				phandle = <0x01>;
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "qcom,ufs-phy-qrbtc-sdm845";
			vdda-phy-supply = <0xffffffff>;
			vdda-phy-max-microamp = <0x3519c>;
			vdda-phy-min-microvolt = <0xdea80>;
			vdda-pll-supply = <0xffffffff>;
