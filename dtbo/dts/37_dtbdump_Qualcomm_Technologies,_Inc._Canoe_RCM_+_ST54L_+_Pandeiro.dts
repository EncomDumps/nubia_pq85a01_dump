	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			reboot_reason {
				compatible = "qcom,reboot-reason";
				nvmem-cells = <0x11>;
				nvmem-cell-names = "restart_reason";
			};

			reboot_ext {
				compatible = "zte,reboot-ext";
				nvmem-cells = <0x12 0x13 0x14 0x15>;
				nvmem-cell-names = "vendor_zlog_ss", "vendor_zlog_w", "vendor_zlog_p", "vendor_zlog_panic_ext";
			};

			reboot_ramdisk_ext {
				compatible = "zte,reboot-ramdisk-ext";
				nvmem-cells = <0x13>;
				nvmem-cell-names = "vendor_ramdisk_zlog";
				memory-region = <0xffffffff>;
			};

			pmic-pon-log {
				compatible = "qcom,pmic-pon-log";
				nvmem = <0x16 0x17>;
				nvmem-names = "pon_log0", "pon_log1";
				depends-on-supply = <0xffffffff>;
