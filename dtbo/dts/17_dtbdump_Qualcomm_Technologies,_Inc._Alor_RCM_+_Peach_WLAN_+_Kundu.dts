	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,pmiv010x@7 {
				compatible = "qcom,spmi-pmic";
				reg = <0x07 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
