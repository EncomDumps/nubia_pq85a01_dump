    getprop persist.vendor.sys.device.lcdcurrent >> $LOGDIR/logcat/pmlog/lcd_current.txt
    echo "========================================" >> $LOGDIR/logcat/pmlog/lcd_current.txt
    debug "get_lcd_current end"
}

function get_wakeup_sources(){
    debug "get_wakeup_sources begin"
    date >> $LOGDIR/logcat/pmlog/wakeup_sources.txt
    if [ -e "/d/wakeup_sources" ]; then
        cat /d/wakeup_sources >> $LOGDIR/logcat/pmlog/wakeup_sources.txt
    elif [ -e "/proc/driver/debug/wakeup_sources" ]; then
        cat /proc/driver/debug/wakeup_sources >> $LOGDIR/logcat/pmlog/wakeup_sources.txt
    else
        echo "wakeup_sources_active not exist" >> $LOGDIR/logcat/pmlog/wakeup_sources.txt
    fi
    echo "========================================" >> $LOGDIR/logcat/pmlog/wakeup_sources.txt
    debug "get_wakeup_sources end"
}

function get_subsystem_sleep_stats(){
    debug "get_subsystem_sleep_stats begin"
    date >> $LOGDIR/logcat/pmlog/subsystem_sleep_info.txt
    if [ -e "/sys/power/rpmh_stats/master_stats" ]; then
        cat /sys/power/rpmh_stats/master_stats >> $LOGDIR/logcat/pmlog/subsystem_sleep_info.txt
    fi
    if [ -e "/sys/power/system_sleep/stats" ]; then
        cat /sys/power/system_sleep/stats >> $LOGDIR/logcat/pmlog/subsystem_sleep_info.txt
    fi
    if [ -e "/sys/power/soc_sleep/stats" ]; then
        cat /sys/power/soc_sleep/stats >> $LOGDIR/logcat/pmlog/subsystem_sleep_info.txt
    fi
    echo "========================================" >> $LOGDIR/logcat/pmlog/subsystem_sleep_info.txt
    debug "get_subsystem_sleep_stats end"
}

function get_qpt_log(){
    debug "get_qpt_log begin"

    # 创建日志文件（如果不存在）
    if [ ! -f "$LOGDIR/logcat/pmlog/power_telemetry.txt" ]; then
        echo "ADB 节点监控日志" > "$LOGDIR/logcat/pmlog/power_telemetry.txt"
        echo "开始时间: $(date)" >> "$LOGDIR/logcat/pmlog/power_telemetry.txt"
        echo "目标节点: qpt:0:0 到 qpt:0:6" >> "$LOGDIR/logcat/pmlog/power_telemetry.txt"
        echo "Debug 0 is comprised of VDD_MXC and VDD_MXA" >> "$LOGDIR/logcat/pmlog/power_telemetry.txt"
        echo "Debug 2 is comprised of VDD_CX and VDD_Modem" >> "$LOGDIR/logcat/pmlog/power_telemetry.txt"
        echo "Debug 4 is comprised of VDD_MM and LPI_CX" >> "$LOGDIR/logcat/pmlog/power_telemetry.txt"
        echo "注意: 功率值已从微瓦(uW)转换为毫瓦(mW)" >> "$LOGDIR/logcat/pmlog/power_telemetry.txt"
        echo "" >> "$LOGDIR/logcat/pmlog/power_telemetry.txt"
    fi

    # 获取当前时间
    current_time="$(date '+%Y-%m-%d %H:%M:%S')"

    # 写入时间戳
    echo "[$current_time]" >> "$LOGDIR/logcat/pmlog/power_telemetry.txt"

    # 读取父节点 qpt:0
    parent_name=""
    parent_power=""

    if [ -f "/sys/class/powercap/qpt/qpt:0/name" ]; then
        parent_name=$(cat /sys/class/powercap/qpt/qpt:0/name 2>/dev/null)
    fi
    if [ -z "$parent_name" ]; then
        parent_name="N/A"
    fi

    if [ -f "/sys/class/powercap/qpt/qpt:0/power_uw" ]; then
        parent_power=$(cat /sys/class/powercap/qpt/qpt:0/power_uw 2>/dev/null)
    fi
    if [ -z "$parent_power" ]; then
        parent_power="N/A"
    else
        # 转换uW到mW
        parent_power=$((parent_power / 1000))
    fi

    # 写入父节点数据
    echo "qpt:0 - Name: $parent_name Power: $parent_power mW" >> "$LOGDIR/logcat/pmlog/power_telemetry.txt"

    # 读取子节点 qpt:0:0 到 qpt:0:6
    for i in $(seq 0 6); do
        name_val=""
        power_val=""

        if [ -f "/sys/class/powercap/qpt/qpt:0/qpt:0:$i/name" ]; then
            name_val=$(cat /sys/class/powercap/qpt/qpt:0/qpt:0:$i/name 2>/dev/null)
        fi
        if [ -z "$name_val" ]; then
            name_val="N/A"
        fi

        if [ -f "/sys/class/powercap/qpt/qpt:0/qpt:0:$i/power_uw" ]; then
            power_val=$(cat /sys/class/powercap/qpt/qpt:0/qpt:0:$i/power_uw 2>/dev/null)
        fi
        if [ -z "$power_val" ]; then
            power_val="N/A"
        else
            # 转换uW到mW
            power_val=$((power_val / 1000))
        fi

        # 写入子节点数据
        echo "qpt:0:$i - Name: $name_val Power: $power_val mW" >> "$LOGDIR/logcat/pmlog/power_telemetry.txt"
    done

    # 添加分隔线
    echo "" >> "$LOGDIR/logcat/pmlog/power_telemetry.txt"
    echo "========================================" >> "$LOGDIR/logcat/pmlog/power_telemetry.txt"

    debug "get_qpt_log end"
}

