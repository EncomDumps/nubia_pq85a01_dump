    debug "get_charge_now_raw begin"
    date >> $LOGDIR/logcat/pmlog/charge_now_raw.txt
    cat /sys/class/power_supply/bms/charge_now_raw >> $LOGDIR/logcat/pmlog/charge_now_raw.txt
    echo "========================================" >> $LOGDIR/logcat/pmlog/charge_now_raw.txt
    debug "get_charge_now_raw end"
}

function get_cpufreq_time_inState(){
    debug "get_cpufreq_time_inState begin"
    time_cur=`date`
    echo $time_cur >> $LOGDIR/logcat/pmlog/cpu0_cpufreq_time_in_state.txt
    cat /sys/devices/system/cpu/cpu0/cpufreq/stats/time_in_state >> $LOGDIR/logcat/pmlog/cpu0_cpufreq_time_in_state.txt
    echo "========================================" >> $LOGDIR/logcat/pmlog/cpu0_cpufreq_time_in_state.txt
    if [ -e "/sys/devices/system/cpu/cpu4" ]; then
        echo $time_cur >> $LOGDIR/logcat/pmlog/cpu6_cpufreq_time_in_state.txt
        cat /sys/devices/system/cpu/cpu4/cpufreq/stats/time_in_state >> $LOGDIR/logcat/pmlog/cpu6_cpufreq_time_in_state.txt
        echo "========================================" >> $LOGDIR/logcat/pmlog/cpu6_cpufreq_time_in_state.txt
        if [ -e "/sys/devices/system/cpu/cpu7" ]; then
            echo $time_cur >> $LOGDIR/logcat/pmlog/cpu7_cpufreq_time_in_state.txt
            cat /sys/devices/system/cpu/cpu7/cpufreq/stats/time_in_state >> $LOGDIR/logcat/pmlog/cpu7_cpufreq_time_in_state.txt
            echo "========================================" >> $LOGDIR/logcat/pmlog/cpu7_cpufreq_time_in_state.txt
        fi;
        if [[ "$platform" == "pineapple" ]]; then
            if [ -e "/sys/devices/system/cpu/cpu5" ]; then
                echo $time_cur >> $LOGDIR/logcat/pmlog/cpu5_cpufreq_time_in_state.txt
                cat /sys/devices/system/cpu/cpu5/cpufreq/stats/time_in_state >> $LOGDIR/logcat/pmlog/cpu5_cpufreq_time_in_state.txt
                echo "========================================" >> $LOGDIR/logcat/pmlog/cpu5_cpufreq_time_in_state.txt
            fi;
        fi;
    else
        echo $time_cur >> $LOGDIR/logcat/pmlog/cpu2_cpufreq_time_in_state.txt
        cat /sys/devices/system/cpu/cpu2/cpufreq/stats/time_in_state >> $LOGDIR/logcat/pmlog/cpu2_cpufreq_time_in_state.txt
        echo "========================================" >> $LOGDIR/logcat/pmlog/cpu2_cpufreq_time_in_state.txt
    fi;
    debug "get_cpufreq_time_inState end"
}

function get_zperf_node_state(){
    debug "get_zperf_node_state begin"
    date >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
    if [ -e "/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq" ]; then
        echo "/sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq,scaling_min_freq" >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_min_freq >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
    fi;

    if [ -e "/sys/class/kgsl/kgsl-3d0/gpuclk" ]; then
        echo "/sys/class/kgsl/kgsl-3d0/gpuclk,max_gpuclk" >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/class/kgsl/kgsl-3d0/gpuclk >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/class/kgsl/kgsl-3d0/max_gpuclk >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
    fi;

    if [ -e "/sys/devices/system/cpu/bus_dcvs/DDR/cur_freq" ]; then
        echo "/sys/devices/system/cpu/bus_dcvs/DDR/cur_freq" >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/devices/system/cpu/bus_dcvs/DDR/cur_freq >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
    fi;

    if [ -e "/sys/devices/system/cpu/bus_dcvs/DDRQOS/boost_freq" ]; then
        echo "/sys/devices/system/cpu/bus_dcvs/DDRQOS/boost_freq" >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/devices/system/cpu/bus_dcvs/DDRQOS/boost_freq >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
    fi;

    if [ -e "/sys/devices/system/cpu/bus_dcvs/L3/boost_freq" ]; then
        echo "/sys/devices/system/cpu/bus_dcvs/L3/boost_freq" >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/devices/system/cpu/bus_dcvs/L3/boost_freq >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
    fi;

    if [ -e "/sys/devices/system/cpu/bus_dcvs/LLCC/boost_freq" ]; then
        echo "/sys/devices/system/cpu/bus_dcvs/LLCC/boost_freq" >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/devices/system/cpu/bus_dcvs/LLCC/boost_freq >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
    fi;

    if [ -e "/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/cur_freq" ]; then
        echo "/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/cur_freq" >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:prime/cur_freq >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
    fi;

    if [ -e "/sys/class/kgsl/kgsl-3d0/clock_mhz" ]; then
        echo "/sys/class/kgsl/kgsl-3d0/clock_mhz" >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/class/kgsl/kgsl-3d0/clock_mhz >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
    fi;

    if [ -e "/sys/class/kgsl/kgsl-3d0/gpu_busy_percentage" ]; then
        echo "/sys/class/kgsl/kgsl-3d0/gpu_busy_percentage" >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/class/kgsl/kgsl-3d0/gpu_busy_percentage >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
    fi;

    if [ -e "/sys/class/devfreq/1d84000.ufshc/cur_freq" ]; then
        echo "/sys/class/devfreq/1d84000.ufshc/cur_freq" >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/class/devfreq/1d84000.ufshc/cur_freq >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
    fi;

    if [ -e "/sys/devices/system/cpu/cpu7/dcvsh_freq_limit" ]; then
        echo "/sys/devices/system/cpu/cpu*/dcvsh_freq_limit" >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
        cat /sys/devices/system/cpu/cpu*/dcvsh_freq_limit >> $LOGDIR/logcat/pmlog/zperf_node_state.txt
    fi;

    echo "========================================" >> $LOGDIR/logcat/pmlog/zperf_node_state.txt

    debug "get_zperf_node_state end"
}

function bak_if_pmlog()
{
    debug "bak_if_pmlog begin"
    local bakfile=$1
    local file=${bakfile##*/}
    local dir=${bakfile%/*}
    local size=$2
    local dir_bk=pwd

    debug "bakfile:$bakfile file:$file dir:$dir size:$size"
    if [ ! -d $bakfile ] ; then
        debug "bakfile:$bakfile donot exist"
        return
    fi

    l=`du -s   $bakfile | awk '{print $1}'`
    if [ "$l" -gt "$2" ] ;then
        debug "rm $bakfile.0.tar.gz"
        #rm $bakfile.0.tar.gz
        pwd
        debug "cd $dir for $dir_bk"
        cd $dir
        debug "$file -> $file.0.tar.gz"
        rm $file.5.tar.gz
        mv $file.4.tar.gz $file.5.tar.gz
        mv $file.3.tar.gz $file.4.tar.gz
        mv $file.2.tar.gz $file.3.tar.gz
        mv $file.1.tar.gz $file.2.tar.gz
        mv $file.0.tar.gz $file.1.tar.gz
        tar zcf $file.0.tar.gz $file
        debug "rm $file"
        rm -rf $bakfile/*
        cd $dir_bk
        pwd
    fi
    debug "bak_if_pmlog end"
}

function get_pm_log(){
    debug "get_pm_log begin"
    if [ "$cell" == "true" ]; then
        if ["$system_id" != ""] ; then
            debug "skip get_pm_log in home and work"
            return
        fi
    fi

    if [ $PMLOG_LOOP_CNT -lt 10 ]; then
        PMLOG_LOOP_CNT=$(($PMLOG_LOOP_CNT + 1))
    else
        get_wakeup_sources
        PMLOG_LOOP_CNT=0
    fi
    get_tcp_info
    #get_acct_info
    get_subsystem_sleep_stats
    get_charge_now_raw
    get_cpufreq_time_inState
    get_thermal_state
    get_zperf_node_state
    get_qpt_log
    bak_if_pmlog  $LOGDIR/logcat/pmlog 8192
    chmod 755 $LOGDIR/logcat/pmlog/*
    chmod 755 $LOGDIR/logcat/pmlog*
    debug "get_pm_log end"
}

function get_robot_log(){
    debug "get_robot_log begin"
    mkdir /sdcard/robot/
    echo "robot enter"  >> /sdcard/robot/robotlog.txt
    get_robot_info
    setprop persist.odm.getqrtr.lookup 1
    debug "get_robot_log end"
}

# Started by AICoder, pid:gd15296fafz32cb1414208daf04055686604914f
# 定义检查日志数量的函数
function check_bugreport_log_num()
{
    # 定义目标目录
    target_dir="/data/user_de/0/com.android.shell/files/bugreports"

    # 检查目录是否存在
    if [ ! -d "$target_dir" ]; then
        debug "Directory $target_dir does not exist."
        return 1
    fi

    # 获取目录中的文件列表（按修改时间排序）
    file_list=$(ls -t "$target_dir")

    # 计算文件数量
    file_count=$(echo "$file_list" | wc -l)

    # 如果文件数量大于20，则删除最早的文件
    while [ $file_count -gt 20 ]; do
        # 获取最早的文件名
        oldest_file=$(echo "$file_list" | tail -n 1)

        # 删除最早的文件
        rm -f "$target_dir/$oldest_file"

        # 更新文件列表和文件数量
        file_list=$(ls -t "$target_dir")
        file_count=$(echo "$file_list" | wc -l)
    done

    debug "File count in $target_dir is now $file_count."
}

# 定义获取bugreport的函数
function get_bugreport_log()
{
    # 检查 getprop 命令的返回值
    if [ "$(getprop persist.sys.monkey)" = "true" ] || [ "$(getprop persist.sys.monkey)" = "1" ]; then
        # 获取SurfaceFlinger的import大小信息
        import_info=$(dumpsys SurfaceFlinger | grep 'Total imported by gralloc')
        size_kb=$(echo $import_info | awk '{print $5}' | sed 's/KiB//')

        # 将KiB转换为MB并检查是否大于3G (3072 MB)
        size_mb=$(awk "BEGIN {printf \"%.2f\", ($size_kb / 1024)}")
        if (( $(echo "$size_mb > 3072" | bc -l) )); then
            debug "persist.sys.monkey is true or 1, and import $size_mb is greater than 3G, executing bugreportz..."
            bugreportz
            check_bugreport_log_num
        else
            debug "persist.sys.monkey is true or 1, but import $size_mb is not greater than 3G, skipping bugreportz."
        fi
    else
        debug "persist.sys.monkey is not true or 1, skipping bugreportz."
    fi
}
# Ended by AICoder, pid:gd15296fafz32cb1414208daf04055686604914f

# Started by AICoder, pid:1aef5z6410yeeee147a20b9b7086f233fa321c08
# 函数：检查进程是否重启
function check_process_restart() {
    local input_process_name="$1"
    local input_pid="$2"

    # 获取当前进程的PID
    current_pid=$(pgrep -f "$input_process_name")

    # 检查输入的PID是否为空
    if [ -z "$input_pid" ]; then
        echo "$current_pid"  # 返回当前查询的PID，按没有变化对待
        return
    fi

    # 检查当前进程是否存在且不为空
    if [ -n "$current_pid" ] && [ "$current_pid" != "$input_pid" ]; then
        # 如果当前PID存在且不同于输入的PID
        if [ $process_restart_bugreport_call_count -lt $max_process_restart_bugreport_call_count ]; then
            echo "ztedbg $input_process_name from $input_pid to $current_pid, $process_restart_bugreport_call_count VS $max_process_restart_bugreport_call_count"

            start bugreport  # 假设start是一个启动服务的命令
            check_bugreport_log_num
        else
            echo "ztedbg maximum bugreport calls reached ($process_restart_bugreport_call_count)."
        fi
        echo "$current_pid"  # 返回新的PID
    else
        echo ""  # 返回空字符串表示没有变化或未找到进程
    fi
}
# Ended by AICoder, pid:1aef5z6410yeeee147a20b9b7086f233fa321c08


# 全局变量
cur_traced_probes_pid=""

# Started by AICoder, pid:ld99eif0d6ef1b2143770841a0e444293b38a1cf 
function monitor_traced_probes() {
    # 检查 bugreport 服务是否正在运行
    if [ "$(getprop init.svc.bugreport)" == "running" ]; then
        echo "ztedbg traced probes bugreport is running, check skipped"
        return
    fi

    # 调用 check_process_restart 函数检查 traced_probes 进程
    all_lines=$(check_process_restart "traced_probes" "$cur_traced_probes_pid")
    echo "ztedbg traced probes check: $all_lines"

    # 获取新的 PID
    new_pid=$(echo "$all_lines" | tail -n 1)

    # 更新全局变量 cur_traced_probes_pid
    if [ -n "$new_pid" ]; then
        cur_traced_probes_pid="$new_pid"
        echo "ztedbg traced probes updated PID: $cur_traced_probes_pid"
    else
        echo "ztedbg traced probes no PID change detected."
    fi

    # 再次检查 bugreport 服务是否正在运行，并记录触发次数
    if [ "$(getprop init.svc.bugreport)" == "running" ]; then
        process_restart_bugreport_call_count=$((process_restart_bugreport_call_count + 1))
        echo "ztedbg traced probes bugreport is triggered $process_restart_bugreport_call_count times"
    fi
}
# Ended by AICoder, pid:ld99eif0d6ef1b2143770841a0e444293b38a1cf 

# global vars used for monitor display device info
cur_dumpsys_sf_display_name_line=""
disp_info_changed_bugreport_trigger_count=0

# Started by AICoder, pid:2feb4f943eq879714b850b97002f0b3387075745
function monitor_display_device_info() {
    local faketest_value=$(getprop persist.sys.dispdevinfofakefortest)
    local disp_info=""

    if [ "x$faketest_value" = "x" ]; then
        # 获取当前显示设备信息
        disp_info=$(dumpsys SurfaceFlinger | grep Display | grep name | head -n 1)
        echo "ztedbg disp info:$disp_info:"
    else
        case "$faketest_value" in
            1)
                echo "ztedbg disp info simulate 001"
                disp_info=' ├─ Display 0 name="Built-in Screen"#43'
                ;;
            2)
                echo "ztedbg disp info simulate 002"
                disp_info=' ├─ Display 0 name="内置屏幕"#43'
                ;;
            *)
                echo "ztedbg disp info unexpected :$dispdevinfofakefortest: for simulate, use default"
                disp_info=' ├─ Display 0 name="Built-in Screen"#12345678'
                ;;
        esac
    fi

    # 检查获取的显示设备信息是否为空
    if [ -n "$disp_info" ]; then
        # 如果之前有记录的显示设备信息
        if [ -n "$cur_dumpsys_sf_display_name_line" ]; then
            # 比较当前和之前的显示设备信息
            if [ "$cur_dumpsys_sf_display_name_line" = "$disp_info" ]; then
                echo "ztedbg disp info not changed:$disp_info:"
            else
                echo "ztedbg disp info change detected:$cur_dumpsys_sf_display_name_line->$disp_info:"

                # 更新当前显示设备信息
                cur_dumpsys_sf_display_name_line=$disp_info
                echo "ztedbg disp info updated:$cur_dumpsys_sf_display_name_line:"

                # 触发错误报告
                start bugreport
                check_bugreport_log_num

                # 检查错误报告服务是否正在运行, may caused by other monitor, but ignore the little probability here
                if [ "$(getprop init.svc.bugreport)" == "running" ]; then
                    # 增加触发错误报告的计数
                    disp_info_changed_bugreport_trigger_count=$((disp_info_changed_bugreport_trigger_count + 1))
                    echo "ztedbg disp info bugreport triggered count $disp_info_changed_bugreport_trigger_count"
                fi
            fi
        else
            # 更新当前显示设备信息
            cur_dumpsys_sf_display_name_line=$disp_info
            echo "ztedbg disp info init:$cur_dumpsys_sf_display_name_line:"
        fi

    else
        echo "ztedbg disp info dumpsys get failed"
    fi
}
# Ended by AICoder, pid:2feb4f943eq879714b850b97002f0b3387075745

