    chmod -R 755  $LOGDIR/data_kernel/*
    chmod -R 777 /data/tcplog/*
    debug "change_files_mod end"
}

function mainloop()
{
    debug "mainloop begin"
    local interval=0
    local e
    local next

    #process_info
    #kmsg
    for e in ${crontab[@]}
    do
        eval next=\${${e}[0]}
        eval interval=\${${e}[1]}
        debug "cur:$e $next $interval $sys_uptime"
        if [ "$sys_uptime" -ge "$next" ] ;then
            interval=$(($interval + $sys_uptime))
            eval ${e}[0]=\$interval
            eval next=\${${e}[0]}
            debug "next:$next $interval $sys_uptime"
            eval local len=\${#${e}[@]}
            local funi=2
            while [ $funi -lt $len ]
            do
                eval \${${e}[$funi]}
                eval debug \${${e}[$funi]}
                funi=$(($funi + 1))
            done
        fi
    done

    debug "mainloop end"
}

function need_log
{
    debug "need_log begin"
    local total=`du -s $LOGDIR | awk '{print $1}'`

    if [ "$total" -ge "1024000" ]; then
        debug "$LOGDIR is over 1G, don't capture log"
        return 1
    fi

    availinfo=`stat -f /data | grep Available`
    availblocks=`echo ${availinfo#*Available:}`
    bsizeinfo=`stat -f /data | grep "Block Size"`
    blocksize=`echo ${bsizeinfo#*Fundamental block size:}`
    let avail_MB=$availblocks/1024*$blocksize/1024
    if [ "$avail_MB" -lt "50" ] ;then
        debug "/data will be filled fullly, stop collecting logs until space is more than 50MB "
        return 1
    fi
    debug "need_log end"
    return 0
}

TRACES_DIR="$LOGDIR/logcat"

function trim_tombstones()
{
    echo "trim_tombstones begin"
    local tf
    local tt=`date +%G%m%d_%H%M%S`

    if [ ! -d $TRACES_DIR ]
    then
        echo "${TRACES_DIR} does not exist"
        return
    fi

    local curdir=`pwd`
    cd $TRACES_DIR
    local num=0
    local MAX_NUM=64
    for  tf in  $(ls -lt *tombstone* | awk '{print $8}')
    do
        echo "${tf}"
        let num=num+1
        if [ $num -gt $MAX_NUM ]
        then
            echo "rm ${tf}"
            rm ${tf}
        fi
    done

    cd $curdir
    echo "trim_tombstones end"
}

function trim_traces()
{
    echo "trim_anrs begin"
    local tf
    local tt=`date +%G%m%d_%H%M%S`
    if [ ! -d $TRACES_DIR]
    then
        echo "${TRACES_DIR} does not exist"
        return
    fi

    local curdir=`pwd`
    cd $TRACES_DIR
    local num=0
    local MAX_NUM=64
    for  tf in  $(ls -lt *anr* | awk '{print $8}')
    do
        echo "${tf}"
        let num=num+1
        if [ $num -gt $MAX_NUM ]
        then
            echo "rm ${tf}"
            rm ${tf}
        fi
    done

    local num=0
    local MAX_NUM=64
    for  tf in  $(ls -lt *trace* | awk '{print $8}')
    do
        echo "${tf}"
        let num=num+1
        if [ $num -gt $MAX_NUM ]
        then
            echo "rm ${tf}"
            rm ${tf}
        fi
    done

    cd $curdir
    echo "trim_anrs end"
}

# Only keep 64 tombstone compressed files
