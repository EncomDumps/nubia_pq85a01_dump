    debug "clear_tombstone_files begin"
  for file in `ls -r $LOGDIR/logcat |grep "tombstone" |tail -n +60`
  do
    rm -rf $LOGDIR/logcat/$file
  done
    debug "clear_tombstone_files end"
}

