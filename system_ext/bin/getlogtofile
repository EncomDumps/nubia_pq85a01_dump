# 初始化 binderspam_num 和 max_binderspam_num
binderspam_num=0
max_binderspam_num=10

# Started by AICoder, pid:eff7051a3b139f9141eb08ecf0938742e558bb75 
# 检查和调用 debuggerd 的函数
function check_and_call_debuggerd() {
    local log_line="$1"

    if echo "$log_line" | grep -qE 'binder_alloc: [0-9]+: pid [0-9]+ spamming oneway\? [0-9]+ buffers allocated for a total size of [0-9]+'; then
        system_server_pid=$(echo "$log_line" | grep -oE 'binder_alloc: ([0-9]+):' | cut -d':' -f2)
        buffers=$(echo "$log_line" | grep -oE '([0-9]+) buffers allocated' | cut -d' ' -f1)
        size=$(echo "$log_line" | grep -oE 'a total size of ([0-9]+)' | cut -d' ' -f5)
    else
        echo "ztedbg failed to match spamming line :$log_line:"
        return 1
    fi

    # 将大小转换为KB
    size_kb=$((size / 1024))

    # 获取实际的 system_server_pid
    real_system_server_pid=$(pidof system_server)
    # remove the space char
    system_server_pid=${system_server_pid// /}
    real_system_server_pid=${real_system_server_pid// /}

    # 检查两个变量是否有一个为空
    if [ -z "$system_server_pid" ] || [ -z "$real_system_server_pid" ]; then
        echo "ztedbg empty :${system_server_pid}:${real_system_server_pid}:"
        return 2
    fi

    # 检查条件
    if [ "$buffers" -gt 2000 ] || [ "$size_kb" -gt 450 ]; then
        # 检查 system_server_pid 是否匹配
        if [ "$system_server_pid" = "$real_system_server_pid" ]; then
            echo "ztedbg buffers: $buffers, Size: ${size_kb}K, PID: $system_server_pid"
            file_monitor_system_server_stacktrace=monitor_system_server_backtrace_${binderspam_num}.txt
            echo "ztedbg :$binderspam_num:$max_binderspam_num: debuggerd -b $system_server_pid to /data/local/vendor_logs/logcat/$file_monitor_system_server_stacktrace ..."
            debuggerd -b "$system_server_pid" > "/data/local/vendor_logs/logcat/$file_monitor_system_server_stacktrace"

            binderspam_num=$((binderspam_num + 1))
            if [ "$binderspam_num" -gt "$max_binderspam_num" ]; then
                binderspam_num=$max_binderspam_num
            fi

        else
            echo "ztedbg PID not match: $system_server_pid vs $real_system_server_pid, :$binderspam_num:$max_binderspam_num:"
        fi
    else
        echo "ztedbg conditions not met :$binderspam_num:$max_binderspam_num:"
    fi
}
# Ended by AICoder, pid:eff7051a3b139f9141eb08ecf0938742e558bb75 

# Started by AICoder, pid:e0f75yc872f00cf1488c09a2701526540e5983c8 
# 定义 system_server_binderbuf_check 函数
function system_server_binderbuf_check() {
    # 日志文件路径
    local log_file="/data/local/vendor_logs/logcat/logcat_kernel.txt"

    # 检查日志文件是否存在
    if [ -f "$log_file" ]; then
        # init to empty string
        local log_line=""

        # 获取属性值并存储在变量中
        local binderspam_value=$(getprop persist.sys.binderspamfakefortest)

        # 检查属性值是否为空
        if [ "x$binderspam_value" = "x" ]; then
            # 从日志文件中提取最新的日志行
            log_line=$(grep "buffers allocated for a total size of" "$log_file" | tail -1)
        else
            local tmp_system_server_pid=$(pidof system_server)
            case "$binderspam_value" in
                1)
                    echo "ztedbg simulate 001"
                    log_line="10-29 11:53:32.869  1750  1750 I binder_alloc: $tmp_system_server_pid: pid 1750 spamming oneway? 2092 buffers allocated for a total size of 502080"
                    ;;
                2)
                    echo "ztedbg simulate 002"
                    log_line="10-29 11:53:32.869  1750  1750 I binder_alloc: $tmp_system_server_pid: pid 1750 spamming oneway? 1092 buffers allocated for a total size of 502080"
                    ;;
                3)
                    echo "ztedbg simulate 003"
                    log_line="10-29 11:53:32.869  1750  1750 I binder_alloc: $tmp_system_server_pid: pid 1750 spamming oneway? 1092 buffers allocated for a total size of 102080"
                    ;;
                4)
                    echo "ztedbg simulate 004"
                    log_line="10-29 11:53:32.869  1750  1750 I binder_alloc: $tmp_system_server_pid: pid 1750 spamming oneway? 2092 buffers allocated for a total size of 102080"
                    ;;
                *)
                    echo "ztedbg unexpected binderspamfakefortest :$log_line:"
                    ;;
            esac
        fi

        if [ -n "$log_line" ]; then
            check_and_call_debuggerd "$log_line"
        else
            echo "ztedbg no binder buffer spam"
        fi
    else
        echo "ztedbg kernel file does not exist: $log_file"
    fi
}
# Ended by AICoder, pid:e0f75yc872f00cf1488c09a2701526540e5983c8 

