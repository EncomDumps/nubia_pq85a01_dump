    ".read_data_address":{
      "owner": "zte_eois",
      "comments": "Read the registers of gyro, acc, temp through spi which a+g sensor provides to the ois side, and the registers and values ​​of who am i(chip id)",
      "ctl1_ois_adrs":{ "type": "flt", "ver": "0",
        "data": "112.0",
        "comments": "Enable gyro ois mode address, Decimal, 0: no need; lsm6dso/dsv: SPI2_CTRL1_OIS 0x70, bmi26x: 0"
      },
      "ctl1_ois_size":{ "type": "flt", "ver": "0",
        "data": "1.0",
        "comments": "Data size of ctl1_ois_adrs need to read, 8bit, Decimal, 0: no need"
      },
      "ctl1_ois_mode":{ "type": "flt", "ver": "0",
        "data": "3.0",
        "comments": "b2: accel enable, b1: gyro ois enable, b0: spi enable, Decimal, 0: no need"
      },
      "ctl2_gyro_adrs":{ "type": "flt", "ver": "0",
        "data": "113.0",
        "comments": "gyro ois range address, Decimal, 0: no need; lsm6dsv: SPI2_CTRL2_OIS 0x71, bmi26x: 0"
      },
      "ctl2_gyro_size":{ "type": "flt", "ver": "0",
        "data": "1.0",
        "comments": "Data size of ctl2_gyro_adrs need to read, 8bit, Decimal, 0: no need"
      },
      "ctl2_gyro_mode":{ "type": "flt", "ver": "0",
        "data": "1.0",
        "comments": "gyro range mask, gyro:125-0x00, 250-0x01, 500-0x02, 1000-0x03, 2000-0x04, Decimal, 0: no need"
      },
      "ctl3_accel_adrs":{ "type": "flt", "ver": "0",
        "data": "0.0",
        "comments": "accel ois range address, Decimal, 0: no need; lsm6dso/dsv: SPI2_CTRL3_OIS 0x72, bmi26x: 0"
      },
      "ctl3_accel_size":{ "type": "flt", "ver": "0",
        "data": "0.0",
        "comments": "Data size of ctl3_accel_adrs need to read, 8bit, Decimal, 0: no need"
      },
      "ctl3_accel_mode":{ "type": "flt", "ver": "0",
        "data": "0.0",
        "comments": "accel range mask, accel:2G-0x00, 4G-0x01, 8G-0x02, 16G-0x03, Decimal, 0: no need"
      },
      "chip_id_address":{ "type": "flt", "ver": "0",
        "data": "15.0",
        "comments": "Decimal, lsm6dso/dsv: SPI2_WHO_AM_I 0xF, bmi26x: OIS_REGA_USR_DATA_1 0x18"
      },
      "chip_id_size":{ "type": "flt", "ver": "0",
        "data": "1.0",
        "comments": "Decimal, min :1.0, max: 2.0， lsm6dso/dsv： 1， bmi26x：2"
      },
      "chip_id":{ "type": "flt", "ver": "0",
        "data": "112.0",
        "comments": "Decimal, lsm6dso/dsv: WHOAMI_VALUE：0x70, bmi26x: OIS_REGA_USR_DATA_1 0x18：0x55aa"
      },
      "read_ois_adrs":{ "type": "flt", "ver": "0",
        "data": "34.0",
        "comments": "a+g sensor provides data low bit address to the ois side, lsm6dso/dsv:need read 14 bit frome 0x20 to 0x2D once required by telecamera in intercept mode, 0x22 in normal mode Decimal"
      },
      "read_ois_size":{ "type": "flt", "ver": "0",
        "data": "4.0",
        "comments": "data size, Decimal, lsm6dso/dsv:6 bit, only read x/y"
      },
      "gyro_ois_index":{ "type": "flt", "ver": "0",
        "data": "0.0",
        "comments": "gyro index in read finnal ois data, Decimal, lsm6dso/dsv:7 num, index: temp:0, gyro:1-3, accel:4-6"
      }
    }
  },
